+// Harness instrumentation hook (weak).
+//
+// Reports progress through HW::Init to a differential-test harness. Declared
+// weak so that every binary linking libcore WITHOUT a harness -- which is all
+// of them in a normal build -- gets the empty default and pays one call.
+//
+// This exists because HW::Init stalls under Emscripten and the usual way to
+// find out where (printf between the calls) is unavailable: with
+// PROXY_TO_PTHREAD, printf is proxied to the browser main thread, so a stall
+// that involves that thread wedges the reporting channel along with the code
+// being reported on.
+// A weak DEFINITION, not a weak declaration. An undefined weak declaration
+// resolves to null on ELF and wasm, but Mach-O requires weak_import for that
+// and otherwise fails the link -- which it did, for every harness binary that
+// does not define the hook. A weak definition links everywhere and is simply
+// replaced when a harness supplies a strong one.
+extern "C" __attribute__((weak)) void harness_hw_stage(const char* name)
+{
+  (void)name;
+}
+#define HW_STAGE(x) harness_hw_stage(x)
+
