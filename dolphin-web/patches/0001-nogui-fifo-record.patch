   auto core_state_changed_hook = Core::AddOnStateChangedCallback([](const Core::State state) {
     if (state == Core::State::Uninitialized)
       s_platform->Stop();
+
+    if (state == Core::State::Running && !s_skylander.empty() && !s_sky_done)
+    {
+      s_sky_done = true;
+      std::thread([] {
+        // The portal device only exists once emulation is up, and the game
+        // polls it continuously, so placing the figure late is equivalent to
+        // setting it down mid-session.
+        std::this_thread::sleep_for(std::chrono::seconds(s_sky_delay));
+        unsigned int id = 0, var = 0;
+        if (std::sscanf(s_skylander.c_str(), "%u:%u", &id, &var) != 2)
+        {
+          fprintf(stderr, "[sky] bad --skylander value '%s', want ID:VAR\n",
+                  s_skylander.c_str());
+          return;
+        }
+        const std::string path = File::GetUserPath(D_USER_IDX) +
+                                 fmt::format("sky_{}_{}.sky", id, var);
+        if (!File::Exists(path))
+        {
+          IOS::HLE::USB::SkylanderFigure fig(path);
+          if (!fig.Create(static_cast<u16>(id), static_cast<u16>(var)))
+          {
+            fprintf(stderr, "[sky] could not create %s\n", path.c_str());
+            return;
+          }
+          fig.Close();
+          fprintf(stderr, "[sky] created %s\n", path.c_str());
+        }
+        auto figure = std::make_unique<IOS::HLE::USB::SkylanderFigure>(path);
+        if (!figure->FileIsOpen())
+        {
+          fprintf(stderr, "[sky] could not open %s\n", path.c_str());
+          return;
+        }
+        const u8 slot = Core::System::GetInstance().GetSkylanderPortal().LoadSkylander(
+            std::move(figure));
+        fprintf(stderr, "[sky] placed id=%u var=%u in portal slot %u\n", id, var, slot);
+      }).detach();
+    }
+
+    if (state == Core::State::Running && s_shot_after > 0 && !s_fifo_started)
+    {
+      s_fifo_started = true;
+      std::thread([] {
+        std::this_thread::sleep_for(std::chrono::seconds(s_shot_after));
+        // A single timed screenshot usually lands on a loading screen or a
+        // fade. A burst makes it possible to find a frame with real content
+        // without re-running the whole boot each time.
+        for (int k = 0; k < s_shot_count; ++k)
+        {
+          if (k)
+            std::this_thread::sleep_for(std::chrono::seconds(s_shot_every));
+          if (s_shot_path.empty())
+            Core::SaveScreenShot();
+          else
+            Core::SaveScreenShot(fmt::format("{}_{:02d}", s_shot_path, k));
+          fprintf(stderr, "[shot] %d/%d\n", k + 1, s_shot_count);
+        }
+        std::this_thread::sleep_for(std::chrono::seconds(3));
+        s_platform->RequestShutdown();
+      }).detach();
+    }
+
+    if (state == Core::State::Running && s_fifo_frames > 0 && !s_fifo_started)
+    {
+      s_fifo_started = true;
+      // Recording must begin once the game is actually drawing. Starting at
+      // State::Running captures the frames before anything is submitted.
+      std::thread([] {
+        if (s_fifo_delay > 0)
+        {
+          fprintf(stderr, "[fifo] waiting %ds for the game to start drawing\n", s_fifo_delay);
+          std::this_thread::sleep_for(std::chrono::seconds(s_fifo_delay));
+        }
+        fprintf(stderr, "[fifo] recording %d frames -> %s\n", s_fifo_frames,
+                s_fifo_output.c_str());
+        Core::System::GetInstance().GetFifoRecorder().StartRecording(s_fifo_frames, [] {
+        FifoDataFile* file = Core::System::GetInstance().GetFifoRecorder().GetRecordedFile();
+        const bool ok = file && file->Save(s_fifo_output);
+        fprintf(stderr, "[fifo] %s %s\n", ok ? "wrote" : "FAILED to write", s_fifo_output.c_str());
+        s_platform->RequestShutdown();
+        });
+      }).detach();
+    }
   });
 
