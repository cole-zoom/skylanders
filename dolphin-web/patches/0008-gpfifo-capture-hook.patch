+
+// Harness capture hook (weak).
+//
+// UpdateGatherPipe is the single choke point for the GX command stream: every
+// 32 bytes the CPU writes to the write-gather pipe passes through here on its
+// way into the FIFO. Hooking it gives the exact byte sequence the GPU would
+// consume, in order, which is what a FIFO decoder needs.
+//
+// Weak DEFINITION, not a weak declaration -- an undefined weak declaration
+// resolves to null on ELF and wasm but fails the link on Mach-O.
+extern "C" __attribute__((weak)) void harness_gp_bytes(const u8* data, size_t size)
+{
+  (void)data;
+  (void)size;
+}
