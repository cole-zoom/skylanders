 void USBHost::DoState(PointerWrap& p)
 {
   Device::DoState(p);
-  if (IsOpened() && p.IsReadMode())
+  // This used to be under IsOpened(), which is never true for a USB host:
+  // USBHost::Open does not call Device::Open, so m_is_active stays false and
+  // the re-scan below never ran. Loading a state in the session that saved it
+  // got away with that (the host still had its devices); a state loaded into a
+  // session in which the game had not opened this host yet left it with no
+  // devices while the restored IDs still named them, and every transfer failed
+  // with ENOENT (the Skylanders portal went silent).
+  if (p.IsReadMode())
   {
+    // Not opened in this session: become a scanner client as Open does.
+    if (!m_has_initialised)
+    {
+      GetSystem().GetUSBScanner().AddClient(this);
+      GetSystem().GetUSBScanner().WaitForFirstScan();
+      m_has_initialised = true;
+    }
+
     // After a state has loaded, there may be insertion hooks for devices that were
     // already plugged in, and which need to be triggered.
     std::lock_guard lk(m_devices_mutex);
