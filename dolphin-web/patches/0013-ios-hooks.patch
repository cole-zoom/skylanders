 // Returns the FD for the newly opened device (on success) or an error code.
+
+// Harness instrumentation hook (weak).
+//
+// Lets a differential harness refuse an IOS device by name, as if it were not
+// present. Needed because some devices make the ORACLE nondeterministic:
+// /dev/net/ip/top performs real host socket operations, so native blocks on a
+// pending socket while wasm's Emscripten socket emulation answers instantly.
+// A reference build whose behaviour depends on host network state cannot be a
+// reference.
+//
+// Refusing the device reuses the existing not-present path (IPC_ENOENT), which
+// is a state the game already has to handle.
+//
+// Weak DEFINITION, not a weak declaration -- an undefined weak declaration
+// resolves to null on ELF and wasm but fails the link on Mach-O.
+extern "C" __attribute__((weak)) int harness_block_device(const char* path)
+{
+  (void)path;
+  return 0;
+}
+
 std::optional<IPCReply> EmulationKernel::OpenDevice(OpenRequest& request)
 {
   const s32 new_fd = GetFreeDeviceID();
@@ -687,6 +708,9 @@ std::optional<IPCReply> EmulationKernel::OpenDevice(OpenRequest& request)
     device = GetDeviceByName("/dev/fs");
   }
 
+  if (device && harness_block_device(request.path.c_str()))
+    device = nullptr;
+
   if (!device)
   {
     constexpr std::string_view cios_devices[] = {"/dev/flash", "/dev/mload", "/dev/sdio/sdhc",
@@ -795,6 +819,27 @@ void EmulationKernel::EnqueueIPCRequest(u32 address)
 }
 
 // Called to send a reply to an IOS syscall
+
+// Harness instrumentation hook (weak).
+//
+// Reports every IPC reply IOS queues: the command, the device file descriptor,
+// the return value, and how far in the future the reply lands. The game polls
+// IPC_PPCCTRL waiting for these, so a reply that is queued differently -- or
+// not queued at all -- stalls the guest at an MMIO read with no other symptom.
+//
+// Weak DEFINITION, not a weak declaration -- an undefined weak declaration
+// resolves to null on ELF and wasm but fails the link on Mach-O.
+extern "C" __attribute__((weak)) void harness_ios_reply(unsigned command, unsigned fd,
+                                                        int return_value, long long cycles,
+                                                        const char* device)
+{
+  (void)command;
+  (void)fd;
+  (void)return_value;
+  (void)cycles;
+  (void)device;
+}
+
 void EmulationKernel::EnqueueIPCReply(const Request& request, const s32 return_value,
                                       s64 cycles_in_future, CoreTiming::FromThread from)
 {
@@ -805,6 +850,15 @@ void EmulationKernel::EnqueueIPCReply(const Request& request, const s32 return_v
   memory.Write_U32(request.command, request.address + 8);
   // IOS also overwrites the command type with the reply type.
   memory.Write_U32(IPC_REPLY, request.address);
+  {
+    // The device name is what makes this log actionable: "an IOCTLV on fd 7
+    // did not reply" names nothing, while "/dev/usb/oh0 did not reply" points
+    // straight at a subsystem that is compiled out under Emscripten.
+    const auto dev = GetDeviceByFileDescriptor(request.fd);
+    harness_ios_reply(request.command, request.fd, return_value,
+                      static_cast<long long>(cycles_in_future),
+                      dev ? dev->GetDeviceName().c_str() : "<none>");
+  }
   system.GetCoreTiming().ScheduleEvent(cycles_in_future, s_event_enqueue, request.address, from);
 }
 
