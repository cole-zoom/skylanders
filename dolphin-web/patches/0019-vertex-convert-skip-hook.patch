+// Harness experiment hook (weak), for docs/PHASE3-WEBGPU.md M4: when it
+// returns true, RunVertices advances over the FIFO's vertices and emits
+// the draw as it would, but converts nothing -- the vertex buffer holds
+// whatever it held. Only meaningful with a backend that draws nothing; it
+// measures what the vertex loader costs the GPU thread.
+//
+// Weak DEFINITION, not a weak declaration: see TextureCacheBase.cpp.
+extern "C" __attribute__((weak)) bool harness_skip_vertex_convert()
+{
+  return false;
+}
+// And a tally hook: each primitive's vertex format (the VCD and VAT words,
