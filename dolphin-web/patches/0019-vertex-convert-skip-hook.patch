+                                                         u32 g1, u32 g2, u32 raw_size,
+                                                         u32 stride, int count)
+{
+  (void)desc_low;
+  (void)desc_high;
+  (void)g0;
+  (void)g1;
+  (void)g2;
+  (void)raw_size;
+  (void)stride;
+  (void)count;
+}
