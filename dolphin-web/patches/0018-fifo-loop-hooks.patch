+// Harness instrumentation hooks (weak), for docs/PHASE3-WEBGPU.md M4.
+//
+// harness_fifo_loop reports each run of the GPU loop's payload: the 32-byte
+// chunks it ran (0 when it found nothing to do -- between the CPU thread's
+// sync points the loop spins until SystemTimers lets it sleep), the runs of
+// the opcode decoder they took, and the CP's enables OR-ed over the run: bit
+// 0 a breakpoint, bit 1 the high-watermark interrupt, bit 2 the low.
+//
+// harness_fifo_batch returns how many chunks the loop may run through the
+// opcode decoder before it updates the CP's status and pulls the CPU
+// thread's events. 1 is Dolphin's loop. More is taken only while no
+// breakpoint is enabled and SyncGPU is off, and never across the FIFO's
+// end.
+//
+// Weak DEFINITIONS, not weak declarations: see TextureCacheBase.cpp.
+extern "C" __attribute__((weak)) void harness_fifo_loop(u32 chunks, u32 batches, u32 enables)
+{
+  (void)chunks;
+  (void)batches;
+  (void)enables;
+}
+extern "C" __attribute__((weak)) u32 harness_fifo_batch()
+{
+  return 1;
+}
+// harness_fifo_spin_limit: after this many runs that found nothing, the
+// loop lets itself sleep rather than spin until SystemTimers' 1 kHz
+// AllowSleep. 0 is Dolphin's loop.
+extern "C" __attribute__((weak)) u32 harness_fifo_spin_limit()
+{
+  return 0;
+}
