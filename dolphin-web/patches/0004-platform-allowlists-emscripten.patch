diff --git a/Source/Core/Core/IOS/Network/Socket.h b/Source/Core/Core/IOS/Network/Socket.h
index 3617e24..6ad5001 100644
--- a/Source/Core/Core/IOS/Network/Socket.h
+++ b/Source/Core/Core/IOS/Network/Socket.h
@@ -14,8 +14,12 @@ typedef pollfd pollfd_t;
 #define MALLOC(x) HeapAlloc(GetProcessHeap(), 0, (x))
 #define FREE(x) HeapFree(GetProcessHeap(), 0, (x))
 
+// Emscripten belongs with the POSIX platforms: it provides <poll.h> and the
+// BSD socket headers below. It is listed explicitly because the fallback
+// #else omits <poll.h> and never defines pollfd_t, which surfaces far away as
+// "use of undeclared identifier 'pollfd_t'" at the first use.
 #elif defined(__linux__) or defined(__APPLE__) or defined(__FreeBSD__) or defined(__NetBSD__) or   \
-    defined(__OpenBSD__) or defined(__HAIKU__)
+    defined(__OpenBSD__) or defined(__HAIKU__) or defined(__EMSCRIPTEN__)
 #include <arpa/inet.h>
 #include <fcntl.h>
 #include <net/if.h>
diff --git a/Source/Core/VideoCommon/DriverDetails.cpp b/Source/Core/VideoCommon/DriverDetails.cpp
index 3027aab..6769bc0 100644
--- a/Source/Core/VideoCommon/DriverDetails.cpp
+++ b/Source/Core/VideoCommon/DriverDetails.cpp
@@ -43,6 +43,14 @@ constexpr u32 m_os = OS_ALL | OS_OPENBSD;
 constexpr u32 m_os = OS_ALL | OS_NETBSD;
 #elif __HAIKU__
 constexpr u32 m_os = OS_ALL | OS_HAIKU;
+#elif __EMSCRIPTEN__
+// The browser is not one of the listed operating systems, and the driver bugs
+// below are matched by OS. Entries tagged OS_ALL still apply; OS-specific ones
+// correctly do not. Without this branch m_os is simply never defined, and the
+// compiler resolves the name to BugInfo::m_os instead -- which fails with
+// "invalid use of non-static data member" rather than anything naming the
+// missing platform.
+constexpr u32 m_os = OS_ALL;
 #endif
 
 static API m_api = API_OPENGL;
