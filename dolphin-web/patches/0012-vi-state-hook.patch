+// Harness instrumentation hook (weak).
+//
+// Reports VI's internal scanline state at the point it decides whether to
+// assert a display interrupt. The decision itself is pure integer arithmetic
+// on m_half_line_count and the programmed VCT/HCT registers, so when two
+// targets reach the same instruction at the same tick and disagree about
+// asserting, one of those values must already differ.
+//
+// Weak DEFINITION, not a weak declaration -- an undefined weak declaration
+// resolves to null on ELF and wasm but fails the link on Mach-O.
+extern "C" __attribute__((weak)) void harness_vi_state(unsigned half_lines, unsigned hlw,
+                                                       unsigned vct0, unsigned hct0,
+                                                       unsigned mask0, unsigned int0)
+{
+  (void)half_lines; (void)hlw; (void)vct0; (void)hct0; (void)mask0; (void)int0;
+}
